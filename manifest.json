{
  "manifest_version": 3,
  "name": "My Better GitHub",
  "version": "1.2.0",
  "description": "Press 1-4 on a GitHub pull request to jump between tabs. Shows each file's Viewed state in the Files changed tree.",
  "homepage_url": "https://github.com/brianpartridge/My-Better-GitHub-Chrome-Extension",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "tab-shortcuts.css"
      ]
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "viewed-tree.js"
      ],
      "css": [
        "viewed-tree.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
