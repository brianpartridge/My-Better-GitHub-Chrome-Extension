{
  "manifest_version": 3,
  "name": "My Better GitHub",
  "version": "1.3.3",
  "description": "GitHub PR shortcuts: 1-4 switch tabs, j/k move between files, v marks a file viewed. Shows Viewed state in the file tree.",
  "homepage_url": "https://github.com/brianpartridge/My-Better-GitHub-Chrome-Extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "tab-shortcuts.css"
      ]
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "viewed-tree.js"
      ],
      "css": [
        "viewed-tree.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "file-nav.js"
      ],
      "css": [
        "file-nav.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
